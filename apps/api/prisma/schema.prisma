generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileRole {
  parent
  pet
  both
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked
}

enum DayOfWeek {
  mon
  tue
  wed
  thu
  fri
  sat
  sun
}

model User {
  id            String      @id @default(uuid())
  authProvider  String
  authSubject   String
  email         String?     @unique
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime?

  profile       Profile?
  interests     UserInterest[]
  availability  UserAvailability[]
  connectionsRequested Connection[] @relation("ConnectionRequester")
  connectionsReceived  Connection[] @relation("ConnectionRecipient")
  messages      Message[]
  deviceTokens  DeviceToken[]
}

model Profile {
  userId          String   @id
  displayName     String
  bio             String?
  role            ProfileRole
  neighborhoodId  String
  avatarUrl       String?
  isProfilePublic Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user         User        @relation(fields: [userId], references: [id])
  neighborhood Neighborhood @relation(fields: [neighborhoodId], references: [id])
  children     Child[]
  pets         Pet[]
}

model Neighborhood {
  id         String   @id @default(uuid())
  name       String
  city       String?
  region     String?
  postalCode String?

  profiles   Profile[]
}

model Child {
  id        String   @id @default(uuid())
  profileId String
  ageRange  String
  createdAt DateTime @default(now())

  profile   Profile @relation(fields: [profileId], references: [userId])
}

model Pet {
  id        String   @id @default(uuid())
  profileId String
  petType   String
  petName   String?
  createdAt DateTime @default(now())

  profile   Profile @relation(fields: [profileId], references: [userId])
}

model Interest {
  id        String   @id @default(uuid())
  label     String   @unique
  category  String?
  isActive  Boolean  @default(true)

  users     UserInterest[]
}

model UserInterest {
  userId     String
  interestId String
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  interest   Interest @relation(fields: [interestId], references: [id])

  @@id([userId, interestId])
}

model AvailabilityWindow {
  id        String   @id @default(uuid())
  label     String   @unique
  timeRange String

  users     UserAvailability[]
}

model UserAvailability {
  userId            String
  availabilityId    String
  dayOfWeek         DayOfWeek
  createdAt         DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id])
  availabilityWindow AvailabilityWindow @relation(fields: [availabilityId], references: [id])

  @@id([userId, availabilityId, dayOfWeek])
}

model Connection {
  id           String           @id @default(uuid())
  requesterId  String
  recipientId  String
  status       ConnectionStatus @default(pending)
  requestedAt  DateTime         @default(now())
  respondedAt  DateTime?

  requester    User             @relation("ConnectionRequester", fields: [requesterId], references: [id])
  recipient    User             @relation("ConnectionRecipient", fields: [recipientId], references: [id])
  messages     Message[]

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
}

model Message {
  id           String   @id @default(uuid())
  connectionId String
  senderId     String
  body         String
  createdAt    DateTime @default(now())

  connection   Connection @relation(fields: [connectionId], references: [id])
  sender       User       @relation(fields: [senderId], references: [id])
}

enum DevicePlatform {
  ios
  android
}

/// An Expo push token for a signed-in user's Mobile App install (ADR 0003 —
/// Expo's Push service, not raw APNs/FCM device tokens).
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user       User           @relation(fields: [userId], references: [id])

  @@index([userId])
}
