# Copy to .env.local (git-ignored); Expo loads it on `expo start`.
# Base URL of the API, including /v1.
# On a real phone this must be your computer's LAN IP, not localhost:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/v1
# The iOS simulator can use localhost; the Android emulator uses 10.0.2.2.
EXPO_PUBLIC_API_URL=http://localhost:3000/v1
